@page "/"
@inject IJSRuntime JS
@inject PdfService Pdf

<h1>Arabic PDF with @@syncfusion/ej2-pdf</h1>

<textarea dir="rtl" lang="ar" @bind="_text" disabled="@_busy"></textarea>

<div>
    <button @onclick="GenerateAsync" disabled="@_busy">@(_busy ? "Working..." : "Generate PDF")</button>
    <button id="extractLinesBtn" @onclick="ExtractAsync" disabled="@_busy">Extract Text</button>
</div>

<div>
    <label for="searchTextInput">Search Text</label>
    <input id="searchTextInput" type="text" dir="rtl" lang="ar" @bind="_searchText" disabled="@_busy" />
    <button id="findTextBtn" @onclick="FindTextAsync" disabled="@_busy">Find Text</button>
    <button id="highlightSearchBtn" @onclick="HighlightAsync" disabled="@_busy">Highlight Search Results</button>
</div>

@if (_path is not null)
{
    <p class="status">Saved to: @_path</p>
}
@if (_error is not null)
{
    <p class="status error">@_error</p>
}

@if (_extracted is not null)
{
    <pre id="extractedTextOutput" class="output-block" dir="rtl" lang="ar">@_extracted</pre>
}

@code {
    private string? _extracted;
    private string? _text;
    private string? _searchText;
    private string? _path;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _text = await Pdf.GetDefaultTextAsync(JS);
        _searchText = await Pdf.GetDefaultSearchTextAsync(JS);
    }

    private Task GenerateAsync() => RunAsync(async () =>
    {
        _path = await Pdf.GenerateAndSaveAsync(JS, _text);
        await Pdf.OpenAsync(_path);
    });

    private Task ExtractAsync() => RunAsync(async () =>
    {
        _extracted = null;
        try { _extracted = await Pdf.ExtractTextAsync(JS); }
        catch (Exception ex) { _extracted = $"Error: {ex.Message}"; }
    });

    private Task FindTextAsync() => RunAsync(async () =>
    {
        _extracted = null;
        try { _extracted = await Pdf.FindTextAsync(JS, _searchText); }
        catch (Exception ex) { _extracted = $"Error: {ex.Message}"; }
    });

    private Task HighlightAsync() => RunAsync(async () =>
    {
        _path = await Pdf.HighlightSearchResultsAndSaveAsync(JS, _searchText);
        await Pdf.OpenAsync(_path);
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try { await action(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
